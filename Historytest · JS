// Tests de l'historique des discussions (sécurité, isolation, validation) — lancer avec : node --test tests/*.test.js
// Un faux Supabase tourne en local (même logique que les fonctions SQL) : aucune vraie donnée.
import test, { before, after } from "node:test";
import assert from "node:assert/strict";
import http from "node:http";
import net from "node:net";
import crypto from "node:crypto";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import path from "node:path";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const SESSION_SECRET = "test-session-secret";
const DB_SECRET = "test-db-secret";
const ALICE = "alice@test.fr", BOB = "bob@test.fr";
const ID1 = "11111111-1111-4111-8111-111111111111", ID2 = "22222222-2222-4222-8222-222222222222";
const uid = () => crypto.randomUUID(); // un identifiant de discussion appartient à UNE seule personne : chaque test crée les siens

// ---------- Faux Supabase : une discussion appartient à UN e-mail ----------
const convs = new Map();   // id -> { email, title, messages, created, updated }
const calls = [];
let tick = 0;
function fakeRpc(fn, a) {
  const email = String(a.p_email || "").toLowerCase().trim();
  switch (fn) {
    case "stars_member_remove": case "stars_member_ensure": return null;
    case "stars_memory_get": return { enabled: true, max: 100, items: [] };
    case "stars_memory_purge": return 0;
    case "stars_conv_list":
      return [...convs.entries()].filter(([, c]) => c.email === email).sort((x, y) => y[1].updated - x[1].updated).slice(0, 100)
        .map(([id, c]) => ({ id, title: c.title, msg_count: c.messages.length, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:0" + (c.updated % 10) + "Z" }));
    case "stars_conv_get": { const c = convs.get(a.p_id); return c && c.email === email ? { id: a.p_id, title: c.title, messages: c.messages, updated_at: "2026-01-01T00:00:00Z" } : null; }
    case "stars_conv_save": {
      const cur = convs.get(a.p_id);
      if (cur && cur.email !== email) return { ok: false, reason: "not_found" };
      if (!cur && [...convs.values()].filter(c => c.email === email).length >= 200) return { ok: false, reason: "full" };
      if (!Array.isArray(a.p_messages)) return { ok: false, reason: "bad_messages" };
      convs.set(a.p_id, { email, title: String(a.p_title).slice(0, 72), messages: a.p_messages, updated: ++tick });
      return { ok: true };
    }
    case "stars_conv_rename": { const c = convs.get(a.p_id); if (!c || c.email !== email) return false; c.title = a.p_title; return true; }
    case "stars_conv_delete": { const c = convs.get(a.p_id); if (!c || c.email !== email) return false; convs.delete(a.p_id); return true; }
    case "stars_conv_clear": { let n = 0; for (const [id, c] of [...convs]) if (c.email === email) { convs.delete(id); n++; } return n; }
    default: throw new Error("fonction inconnue : " + fn);
  }
}
const readBody = req => new Promise(ok => { const c = []; req.on("data", d => c.push(d)); req.on("end", () => ok(Buffer.concat(c).toString("utf8"))); });
let mock;
async function mockHandler(req, res) {
  const raw = await readBody(req);
  const m = new URL(req.url, "http://x").pathname.match(/^\/rest\/v1\/rpc\/([a-z_]+)$/);
  if (!m) { res.writeHead(404); return res.end(); }
  const args = raw ? JSON.parse(raw) : {};
  if (args.p_secret !== DB_SECRET) { res.writeHead(403); return res.end("{}"); }
  calls.push({ fn: m[1], email: args.p_email });
  try {
    const out = fakeRpc(m[1], args);
    res.writeHead(200, { "content-type": "application/json" });
    res.end(out === null ? "" : JSON.stringify(out));
  } catch (e) { res.writeHead(500); res.end(JSON.stringify({ message: e.message })); }
}

// ---------- Lancement du vrai serveur ----------
const logs = [];
const freePort = () => new Promise(ok => { const s = net.createServer().listen(0, () => { const p = s.address().port; s.close(() => ok(p)); }); });
async function startServer(extraEnv = {}) {
  const port = await freePort();
  const mockUrl = `http://127.0.0.1:${mock.address().port}`;
  const child = spawn(process.execPath, ["server.js"], {
    cwd: ROOT,
    env: { PATH: process.env.PATH, PORT: String(port), SESSION_SECRET, AUTH_REQUIRED: "1", SUPABASE_URL: mockUrl, SUPABASE_KEY: "test-key",
           MEMBERS_SECRET: DB_SECRET, GEMINI_API_KEY: "test-gemini-key", GEMINI_BASE_URL: mockUrl, SKIP_SELF_CHECK: "1", ...extraEnv }
  });
  child.stdout.on("data", d => logs.push(String(d)));
  child.stderr.on("data", d => logs.push(String(d)));
  const base = `http://127.0.0.1:${port}`;
  for (let i = 0; i < 60; i++) {
    try { if ((await fetch(base + "/healthz")).ok) return { base, stop: () => child.kill() }; } catch {}
    await new Promise(r => setTimeout(r, 100));
  }
  child.kill();
  throw new Error("le serveur ne démarre pas :\n" + logs.join(""));
}
let S, S_OFF;
before(async () => {
  mock = http.createServer(mockHandler);
  await new Promise(ok => mock.listen(0, "127.0.0.1", ok));
  S = await startServer();
  S_OFF = await startServer({ HISTORY_ENABLED: "0" });
});
after(() => { S?.stop(); S_OFF?.stop(); mock?.close(); });

// ---------- Outils ----------
function cookieFor(email) {
  const body = Buffer.from(JSON.stringify({ e: email, n: "Test", x: Date.now() + 3600_000 })).toString("base64url");
  const sig = crypto.createHmac("sha256", SESSION_SECRET).update("sess|" + body + "|").digest("base64url");
  return "stars_session=" + encodeURIComponent(body + "." + sig);
}
async function call(server, method, p, { who, body, raw } = {}) {
  const headers = {};
  if (who) headers.cookie = cookieFor(who);
  let payload;
  if (body !== undefined) { headers["content-type"] = "application/json"; payload = JSON.stringify(body); }
  if (raw) { headers["content-type"] = raw.type; payload = raw.body; }
  const r = await fetch(server.base + p, { method, headers, body: payload });
  const text = await r.text();
  let json = null; try { json = JSON.parse(text); } catch {}
  return { status: r.status, json, text };
}
const api = (method, p, opt) => call(S, method, p, opt);
const save = (who, id, title, messages) => api("POST", "/api/conversations/save", { who, body: { id, title, messages } });
const MSGS = [{ role: "user", content: "Bonjour" }, { role: "assistant", content: "Salut !" }];

// ---------- Accès ----------
test("sans connexion, toutes les routes de l'historique refusent (401)", async () => {
  assert.equal((await api("GET", "/api/conversations")).status, 401);
  assert.equal((await api("GET", "/api/conversations/" + ID1)).status, 401);
  for (const p of ["save", "rename", "delete", "clear"]) assert.equal((await api("POST", "/api/conversations/" + p, { body: { id: ID1 } })).status, 401, p);
});
test("un cookie de session falsifié est refusé", async () => {
  const bad = cookieFor(ALICE).replace(/.$/, c => (c === "A" ? "B" : "A"));
  assert.equal((await fetch(S.base + "/api/conversations", { headers: { cookie: bad } })).status, 401);
});
test("les requêtes d'écriture doivent être en JSON (415)", async () => {
  assert.equal((await api("POST", "/api/conversations/save", { who: ALICE, raw: { type: "text/plain", body: "x" } })).status, 415);
});

// ---------- Fonctionnement (formats attendus par index.html) ----------
test("enregistrer, lister, ouvrir, renommer, supprimer une discussion", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "carol@test.fr";
  assert.equal((await api("GET", "/api/conversations", { who })).json.items.length, 0);
  assert.equal((await save(who, ID1, "Mes volcans", MSGS)).status, 200);
  const list = await api("GET", "/api/conversations", { who });
  assert.deepEqual(list.json.items.map(i => i.title), ["Mes volcans"]);
  assert.equal(list.json.items[0].id, ID1);
  assert.ok(!list.text.includes("@"), "l'API ne doit pas renvoyer d'e-mail");
  const one = await api("GET", "/api/conversations/" + ID1, { who });
  assert.equal(one.status, 200);
  assert.equal(one.json.item.id, ID1);
  assert.deepEqual(one.json.item.messages, MSGS);
  assert.equal((await api("POST", "/api/conversations/rename", { who, body: { id: ID1, title: "  Volcans   2  " } })).status, 200);
  assert.equal((await api("GET", "/api/conversations", { who })).json.items[0].title, "Volcans 2");
  assert.equal((await api("POST", "/api/conversations/delete", { who, body: { id: ID1 } })).status, 200);
  assert.equal((await api("GET", "/api/conversations", { who })).json.items.length, 0);
  assert.equal((await api("POST", "/api/conversations/delete", { who, body: { id: ID1 } })).status, 404);
});
test("les discussions se retrouvent sur un autre appareil (même compte, nouvelle session)", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "dora@test.fr";
  await save(who, ID2, "Sur mon téléphone", MSGS);
  const fromPc = await api("GET", "/api/conversations/" + ID2, { who }); // autre cookie = autre appareil
  assert.deepEqual(fromPc.json.item.messages, MSGS);
});
test("les plus récentes passent en premier", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "eve@test.fr";
  await save(who, ID1, "Ancienne", MSGS);
  await save(who, ID2, "Récente", MSGS);
  assert.deepEqual((await api("GET", "/api/conversations", { who })).json.items.map(i => i.title), ["Récente", "Ancienne"]);
  await save(who, ID1, "Ancienne remise en tête", MSGS);
  assert.equal((await api("GET", "/api/conversations", { who })).json.items[0].title, "Ancienne remise en tête");
});

// ---------- Isolation ----------
test("ISOLATION : personne ne lit, n'écrase, ne renomme ni ne supprime la discussion d'un autre", async () => {
  const ID1 = uid(), ID2 = uid();
  await save(ALICE, ID1, "Secret d'Alice", MSGS);
  // Bob ne voit rien, même en forçant l'e-mail
  assert.equal((await api("GET", "/api/conversations?email=" + ALICE, { who: BOB })).json.items.length, 0);
  assert.equal((await api("GET", "/api/conversations/" + ID1, { who: BOB })).status, 404);
  // Bob tente d'écraser la discussion d'Alice en réutilisant son identifiant
  const hijack = await save(BOB, ID1, "Piraté", [{ role: "user", content: "pirate" }]);
  assert.equal(hijack.status, 404);
  assert.equal(convs.get(ID1).title, "Secret d'Alice");
  assert.deepEqual(convs.get(ID1).messages, MSGS);
  // …ni renommer, ni supprimer
  assert.equal((await api("POST", "/api/conversations/rename", { who: BOB, body: { id: ID1, title: "Piraté" } })).status, 404);
  assert.equal((await api("POST", "/api/conversations/delete", { who: BOB, body: { id: ID1 } })).status, 404);
  assert.equal(convs.get(ID1).email, ALICE);
  // Bob envoie l'e-mail d'Alice dans le corps : le serveur utilise celui de la session
  const before = calls.length;
  await api("POST", "/api/conversations/save", { who: BOB, body: { id: ID2, title: "À Bob", email: ALICE, p_email: ALICE, messages: MSGS } });
  const used = calls.slice(before).filter(c => c.fn === "stars_conv_save").map(c => c.email);
  assert.deepEqual(used, [BOB]);
  assert.equal(convs.get(ID2).email, BOB);
  // Tout effacer chez Bob n'efface rien chez Alice
  assert.equal((await api("POST", "/api/conversations/clear", { who: BOB, body: {} })).json.deleted, 1);
  assert.equal(convs.get(ID1).email, ALICE);
});

// ---------- Validation ----------
test("identifiants invalides refusés (400), sans appel à la base", async () => {
  const before = calls.filter(c => c.fn.startsWith("stars_conv_")).length;
  for (const id of ["1", "../../etc/passwd", "not-a-uuid", "11111111-1111-4111-8111-11111111111Z", ID1 + "x"]) {
    assert.equal((await save(ALICE, id, "t", MSGS)).status, 400, id);
  }
  assert.equal((await api("GET", "/api/conversations/not-a-uuid", { who: ALICE })).status, 400);
  assert.equal(calls.filter(c => c.fn.startsWith("stars_conv_")).length, before);
});
test("messages : rôles inconnus ignorés, contenu et nombre limités, photo seule ignorée", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "frank@test.fr";
  const odd = [{ role: "system", content: "pirate" }, { role: "user", content: "ok" }, { role: "user", content: 42 }, null, { role: "assistant", content: "x".repeat(40000) }, { role: "user", content: "   " }];
  assert.equal((await save(who, ID1, "t", odd)).status, 200);
  const stored = convs.get(ID1).messages;
  assert.equal(stored.length, 2);
  assert.equal(stored[1].content.length, 30000);
  assert.ok(stored.every(m => m.role === "user" || m.role === "assistant"));
  const many = Array.from({ length: 100 }, (_, i) => ({ role: i % 2 ? "assistant" : "user", content: "m" + i }));
  await save(who, ID2, "t", many);
  assert.equal(convs.get(ID2).messages.length, 60);
  assert.equal(convs.get(ID2).messages.at(-1).content, "m99", "on garde les plus récents");
  const photoOnly = await save(who, "33333333-3333-4333-8333-333333333333", "t", [{ role: "user", content: "" }]);
  assert.equal(photoOnly.status, 200);
  assert.equal(photoOnly.json.skipped, true);
  assert.equal(convs.has("33333333-3333-4333-8333-333333333333"), false);
  assert.equal((await api("POST", "/api/conversations/save", { who, body: { id: ID1, title: "t", messages: "pas une liste" } })).status, 400);
});
test("titre : nettoyé et limité à 72 caractères ; titre vide refusé au renommage", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "gina@test.fr";
  await save(who, ID1, "  Un\u0000   titre\n très long " + "x".repeat(200), MSGS);
  const t = convs.get(ID1).title;
  assert.ok(t.length <= 72 && !/[\u0000\n]/.test(t) && t.startsWith("Un titre très long"));
  assert.equal((await api("POST", "/api/conversations/rename", { who, body: { id: ID1, title: "   " } })).status, 400);
});

// ---------- Compte, réglage, confidentialité ----------
test("la suppression du compte efface toutes les discussions", async () => {
  const ID1 = uid(), ID2 = uid();
  const who = "hank@test.fr";
  await save(who, ID1, "À effacer", MSGS);
  assert.equal(convs.has(ID1), true);
  const r = await api("POST", "/api/account/delete", { who, body: {} });
  assert.equal(r.status, 200);
  assert.ok(calls.some(c => c.fn === "stars_conv_clear" && c.email === who));
  assert.equal(convs.has(ID1), false);
});
test("HISTORY_ENABLED=0 coupe l'historique en ligne (404)", async () => {
  const r = await call(S_OFF, "GET", "/api/conversations", { who: ALICE });
  assert.equal(r.status, 404);
  assert.equal(r.json.code, "history_off");
});
test("le contenu des discussions n'apparaît jamais dans les journaux", async () => {
  const ID1 = uid(), ID2 = uid();
  await save("ivan@test.fr", ID2, "TITRE-SECRET-12345", [{ role: "user", content: "MESSAGE-SECRET-67890" }]);
  await api("GET", "/api/conversations/" + ID2, { who: "ivan@test.fr" });
  const all = logs.join("");
  for (const secret of ["TITRE-SECRET", "MESSAGE-SECRET", "Secret d'Alice", "pirate"]) assert.ok(!all.includes(secret), secret);
});
