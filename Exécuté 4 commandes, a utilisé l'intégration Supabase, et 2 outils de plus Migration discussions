-- STARS AI : historique des discussions en ligne (nouvelle table et nouvelles fonctions uniquement)
-- Les anciennes tables conversations / messages (ancien système de comptes) ne sont pas touchées.
create table if not exists public.stars_conversations (
  id         uuid primary key,
  email      text not null check (char_length(email) between 3 and 254),
  title      text not null default 'Nouvelle discussion' check (char_length(title) between 1 and 120),
  messages   jsonb not null default '[]'::jsonb check (jsonb_typeof(messages) = 'array'),
  msg_count  integer not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists stars_conversations_email_idx on public.stars_conversations (email, updated_at desc);
alter table public.stars_conversations enable row level security;
revoke all on public.stars_conversations from public, anon, authenticated;

-- Logique (schéma privé) : TOUTES les requêtes sont filtrées par l'e-mail de la personne.
create or replace function stars_private.conv_list(p_email text) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
declare v_email text := lower(trim(coalesce(p_email, '')));
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  return coalesce((
    select jsonb_agg(jsonb_build_object('id', c.id, 'title', c.title, 'msg_count', c.msg_count,
                                        'created_at', c.created_at, 'updated_at', c.updated_at) order by c.updated_at desc)
      from (select * from public.stars_conversations x where x.email = v_email order by x.updated_at desc limit 100) c
  ), '[]'::jsonb);
end $fn$;

create or replace function stars_private.conv_get(p_email text, p_id uuid) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
declare v_email text := lower(trim(coalesce(p_email, ''))); v jsonb;
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  select jsonb_build_object('id', c.id, 'title', c.title, 'messages', c.messages, 'updated_at', c.updated_at)
    into v from public.stars_conversations c where c.id = p_id and c.email = v_email;
  return v;
end $fn$;

create or replace function stars_private.conv_save(p_email text, p_id uuid, p_title text, p_messages jsonb) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
declare
  v_email text := lower(trim(coalesce(p_email, '')));
  v_title text := left(btrim(regexp_replace(coalesce(p_title, ''), '\s+', ' ', 'g')), 72);
  v_owner text; v_count integer; v_n integer;
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  if v_title = '' then v_title := 'Nouvelle discussion'; end if;
  if p_messages is null or jsonb_typeof(p_messages) <> 'array' then return jsonb_build_object('ok', false, 'reason', 'bad_messages'); end if;
  if jsonb_array_length(p_messages) > 60 then return jsonb_build_object('ok', false, 'reason', 'too_many_messages'); end if;
  if octet_length(p_messages::text) > 500000 then return jsonb_build_object('ok', false, 'reason', 'too_large'); end if;
  perform pg_advisory_xact_lock(hashtextextended('stars_conversations:' || v_email, 0));
  select c.email into v_owner from public.stars_conversations c where c.id = p_id;
  if found and v_owner <> v_email then return jsonb_build_object('ok', false, 'reason', 'not_found'); end if; -- on ne révèle jamais qu'un identifiant appartient à quelqu'un d'autre
  if not found then
    select count(*) into v_count from public.stars_conversations c where c.email = v_email;
    if v_count >= 200 then return jsonb_build_object('ok', false, 'reason', 'full'); end if;
  end if;
  insert into public.stars_conversations as c (id, email, title, messages, msg_count, created_at, updated_at)
  values (p_id, v_email, v_title, p_messages, jsonb_array_length(p_messages), clock_timestamp(), clock_timestamp())
  on conflict (id) do update set title = excluded.title, messages = excluded.messages, msg_count = excluded.msg_count, updated_at = clock_timestamp()
  where c.email = v_email;
  get diagnostics v_n = row_count;
  if v_n = 0 then return jsonb_build_object('ok', false, 'reason', 'not_found'); end if;
  return jsonb_build_object('ok', true);
end $fn$;

create or replace function stars_private.conv_rename(p_email text, p_id uuid, p_title text) returns boolean
language plpgsql security definer set search_path = '' as $fn$
declare
  v_email text := lower(trim(coalesce(p_email, '')));
  v_title text := left(btrim(regexp_replace(coalesce(p_title, ''), '\s+', ' ', 'g')), 72);
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  if v_title = '' then return false; end if;
  update public.stars_conversations c set title = v_title where c.id = p_id and c.email = v_email;
  return found;
end $fn$;

create or replace function stars_private.conv_delete(p_email text, p_id uuid) returns boolean
language plpgsql security definer set search_path = '' as $fn$
declare v_email text := lower(trim(coalesce(p_email, '')));
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  delete from public.stars_conversations c where c.id = p_id and c.email = v_email;
  return found;
end $fn$;

create or replace function stars_private.conv_clear(p_email text) returns integer
language plpgsql security definer set search_path = '' as $fn$
declare v_email text := lower(trim(coalesce(p_email, ''))); v_n integer;
begin
  if char_length(v_email) < 3 then raise exception 'bad_email' using errcode = '22023'; end if;
  delete from public.stars_conversations c where c.email = v_email;
  get diagnostics v_n = row_count;
  return v_n;
end $fn$;

-- Fonctions appelées par le serveur : elles exigent le secret, comme toutes les fonctions stars_*
create or replace function public.stars_conv_list(p_secret text, p_email text) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_list(p_email); end $fn$;
create or replace function public.stars_conv_get(p_secret text, p_email text, p_id uuid) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_get(p_email, p_id); end $fn$;
create or replace function public.stars_conv_save(p_secret text, p_email text, p_id uuid, p_title text, p_messages jsonb) returns jsonb
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_save(p_email, p_id, p_title, p_messages); end $fn$;
create or replace function public.stars_conv_rename(p_secret text, p_email text, p_id uuid, p_title text) returns boolean
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_rename(p_email, p_id, p_title); end $fn$;
create or replace function public.stars_conv_delete(p_secret text, p_email text, p_id uuid) returns boolean
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_delete(p_email, p_id); end $fn$;
create or replace function public.stars_conv_clear(p_secret text, p_email text) returns integer
language plpgsql security definer set search_path = '' as $fn$
begin perform public.stars_check_secret(p_secret); return stars_private.conv_clear(p_email); end $fn$;

-- Droits d'exécution : mêmes règles que les fonctions stars_* existantes (anon + service_role)
revoke all on function stars_private.conv_list(text) from public, anon, authenticated;
revoke all on function stars_private.conv_get(text, uuid) from public, anon, authenticated;
revoke all on function stars_private.conv_save(text, uuid, text, jsonb) from public, anon, authenticated;
revoke all on function stars_private.conv_rename(text, uuid, text) from public, anon, authenticated;
revoke all on function stars_private.conv_delete(text, uuid) from public, anon, authenticated;
revoke all on function stars_private.conv_clear(text) from public, anon, authenticated;

revoke all on function public.stars_conv_list(text, text) from public, authenticated;
revoke all on function public.stars_conv_get(text, text, uuid) from public, authenticated;
revoke all on function public.stars_conv_save(text, text, uuid, text, jsonb) from public, authenticated;
revoke all on function public.stars_conv_rename(text, text, uuid, text) from public, authenticated;
revoke all on function public.stars_conv_delete(text, text, uuid) from public, authenticated;
revoke all on function public.stars_conv_clear(text, text) from public, authenticated;
grant execute on function public.stars_conv_list(text, text) to anon, service_role;
grant execute on function public.stars_conv_get(text, text, uuid) to anon, service_role;
grant execute on function public.stars_conv_save(text, text, uuid, text, jsonb) to anon, service_role;
grant execute on function public.stars_conv_rename(text, text, uuid, text) to anon, service_role;
grant execute on function public.stars_conv_delete(text, text, uuid) to anon, service_role;
grant execute on function public.stars_conv_clear(text, text) to anon, service_role;
